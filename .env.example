# Discord Developer Portal bot token
DISCORD_TOKEN=

# Discord application / server IDs
CLIENT_ID=
GUILD_ID=

# Gemini API key for image and suspicious-text scanning
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional moderation log channel ID (serious violations and AI failures)
MOD_LOG_CHANNEL_ID=

# Direct HTTPS URL for the LAMPOON logo; used as the embed thumbnail and footer icon.
# The code uses this URL by default; a hosting variable can override it.
LAMPOON_ICON_URL=https://cdn.discordapp.com/attachments/1532817641490874491/1562134042248478750/Dofoto_20261021_000232084.png?ex=6ad98af2&is=6ad83972&hm=795eb8acb674ed9005ce69ff28781ebeb87aeaab98be3ab60217d4ae035cdcf8&
