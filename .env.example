# Render health endpoint is available at GET /health; PORT is set automatically by Render.
# Discord Developer Portal bot token
DISCORD_TOKEN=

# Discord application / server IDs
CLIENT_ID=
GUILD_ID=

# Gemini API key for image and suspicious-text scanning
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional secondary image scanner used when Gemini is quota-limited or inconclusive
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# Optional private staff moderation log channel ID
MOD_LOG_CHANNEL_ID=

# Optional member-facing moderation explanation channel ID (must differ from MOD_LOG_CHANNEL_ID)
REMINDER_LOG_CHANNEL_ID=

# Optional HTTPS URL for the LAMPOON sticky/pinned embed thumbnail. Existing sticky thumbnails are preserved on refresh if this is blank. Set this to guarantee a thumbnail on new channels.
LAMPOON_ICON_URL=

# Footer icon URL only (independent from the thumbnail URL).
LAMPOON_FOOTER_ICON_URL=https://cdn.discordapp.com/attachments/1532817641490874491/1562134042248478750/Dofoto_20261021_000232084.png?ex=6ad98af2&is=6ad83972&hm=795eb8acb674ed9005ce69ff28781ebeb87aeaab98be3ab60217d4ae035cdcf8&
